<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PrimeProFast Native"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="#2196F3"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:gravity="center" />

    <!-- Menu de navegação -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_menu_calculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cálculo de Primos"
                android:layout_marginEnd="8dp"
                android:background="#2196F3"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_menu_primos_grandes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Primos Grandes"
                android:layout_marginEnd="8dp"
                android:background="#4CAF50"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_menu_arquivos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arquivos"
                android:layout_marginEnd="8dp"
                android:background="#9C27B0"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_menu_config"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Config"
                android:background="#607D8B"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
